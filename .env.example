# Hosting (docs/hosting.md). Nest en Railway escucha 0.0.0.0:$PORT.
PORT="3000"
# Allowlist CORS del front (Vercel). Coma-separada; origen sin path.
# Local:
PUBLIC_WEB_ORIGIN="http://localhost:4200"
# Railway (prod): PUBLIC_WEB_ORIGIN="https://proyectocarta.com,https://www.proyectocarta.com"
# Solo el build de Vercel (apps/web). No proxear /api por Vercel.
# API_PUBLIC_URL="https://api.proyectocarta.com/api/v1"
# Smoke del primer deploy (scripts/smoke-prod.mjs). Nunca commitear estas claves.
# SMOKE_ADMIN_EMAIL="operador@tu-dominio"
# SMOKE_ADMIN_PASSWORD=""

DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Directo (5432) para migraciones Prisma. No uses el pooler 6543.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth del Panel Admin (NestJS JWT — docs/architecture.md §2.3)
# Solo en el host de la API (Railway). Nunca en Vercel ni en el bundle Angular.
# En prod: openssl rand -base64 48  (dos valores distintos, ≥32 chars).
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_ACCESS_EXPIRES_SECONDS="900"
AUTH_PEPPER="cambiar-por-otro-secreto-distinto-al-jwt"
AUTH_REFRESH_COOKIE_NAME="pc_refresh"
AUTH_REFRESH_EXPIRES_DAYS="14"
# Local HTTP: false. Railway HTTPS: AUTH_COOKIE_SECURE="true" (el arranque lo exige).
AUTH_COOKIE_SECURE="false"
# Rate limit de login por IP (Nest en Railway, no en Vercel).
AUTH_LOGIN_RATE_LIMIT="5"
AUTH_LOGIN_RATE_TTL_SECONDS="60"
# Tope público si el slug no resuelve un Plan. El menú/analytics usan Plan.rateLimitPerMinute.
PUBLIC_RATE_LIMIT_FALLBACK_PER_MINUTE="60"

# Seed local de PLATFORM_ADMIN (prisma/seed-admin.ts). Nunca en Railway.
# No uses admin123. En prod el operador se crea a mano (docs/hosting.md).
# PLATFORM_ADMIN_EMAIL="tu-email-local@ejemplo.com"
# PLATFORM_ADMIN_PASSWORD=""
# PLATFORM_ADMIN_FULL_NAME="Platform Admin"

# Storage (Supabase Storage — docs/architecture.md §2.3 / domain-modules.md §5)
# Usar la service_role key SOLO en el servidor NestJS. Nunca en el frontend.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="menu-assets"
MEDIA_IMAGE_MAX_BYTES="10485760"
MEDIA_MODEL_MAX_BYTES="52428800"
