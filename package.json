{
  "name": "proyectocarta",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run start --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "test:web": "npm run test --workspace=web",
    "test:api": "npm run test --workspace=api",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "storage:ensure-bucket": "node scripts/ensure-storage-bucket.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "prisma": "^6.19.2"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
